+double drawHalfCauchyRate(MbRandom* rng, double scale) {
+    const double pi = 3.14159265358979323846;
+    const double maxRate = 1000.0;
+
+    // Rate proposals reject values above 1000, so initialize from the same
+    // effective support instead of allowing an unrecoverable starting value.
+    for (int attempt = 0; attempt < 100000; attempt++) {
+        double u = rng->uniformRv();
+        double value = std::fabs(scale * std::tan(pi * (u - 0.5)));
+        if (std::isfinite(value) && value > 0.0 && value < maxRate)
+            return value;
+    }
+    return (scale < maxRate ? scale : maxRate * 0.5);
+}
+
+}
