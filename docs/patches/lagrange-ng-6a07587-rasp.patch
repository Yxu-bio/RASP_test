+
+TEST_F(ConfigFileTest, period_rate_parameters) {
+  constexpr auto config_text =
+      "areanames = RA RB RC\n"
+      "dispersion = 2.0\n"
+      "extinction = 3.0\n"
+      "period early\n"
+      "period early end = 1.0\n"
+      "period early dispersion = 0.5\n"
+      "period early extinction = 0.8\n"
+      "period middle\n"
+      "period middle start = 1.0\n"
+      "period middle end = 2.0\n"
+      "period middle dispersion = 1e-3\n"
+      "period middle extinction = 2e-3\n"
+      "period late\n"
+      "period late start = 2.0\n";
+
+  std::istringstream iss{config_text};
+  ConfigFile config{iss, true};
+  auto params = config.period_params();
+
+  ASSERT_EQ(params.size(), 3);
+
+  EXPECT_EQ(params[0].name, "early");
+  EXPECT_DOUBLE_EQ(params[0].dispersion_rate, 0.5);
+  EXPECT_DOUBLE_EQ(params[0].extinction_rate, 0.8);
+
+  EXPECT_EQ(params[1].name, "middle");
+  EXPECT_DOUBLE_EQ(params[1].dispersion_rate, 1e-3);
+  EXPECT_DOUBLE_EQ(params[1].extinction_rate, 2e-3);
+
+  EXPECT_EQ(params[2].name, "late");
+  EXPECT_DOUBLE_EQ(params[2].dispersion_rate, 2.0);
+  EXPECT_DOUBLE_EQ(params[2].extinction_rate, 3.0);
+}
